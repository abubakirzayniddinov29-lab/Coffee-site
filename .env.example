# 🤖 Telegram bot (client-side mode — token is visible in the bundle!)
VITE_TG_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
VITE_TG_CHAT_ID=YOUR_CHAT_ID_HERE

# 🔒 Recommended for production on Vercel: keep the token on the server.
# VITE_USE_SERVERLESS=true
# TG_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
# TG_CHAT_ID=YOUR_CHAT_ID_HERE
